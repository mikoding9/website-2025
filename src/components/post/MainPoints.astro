---
import type { Highlight } from "../../utils/api";

const { post } = Astro.props;
---

<section
  class='w-full px-3 sm:px-6 grid grid-cols-1 lg:grid-cols-4 gap-4 sm:gap-6 text-neutral-800 my-8 sm:my-12'
>
  <h5 class='text-2xl sm:text-3xl lg:text-4xl'>Main Points</h5>
  <div
    class='col-span-1 lg:col-span-3 grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6'
  >
    {
      post.main_point &&
        post.main_point.map((point: Highlight) => (
          <article class='space-y-3 sm:space-y-6'>
            <h6 class='text-lg sm:text-xl font-medium'>{point.title}</h6>
            <div
              set:html={point.description}
              class='mutate-list space-y-2 sm:space-y-3 text-sm sm:text-base'
            />
          </article>
        ))
    }
  </div>
</section>

<style>
  .mutate-list :global(ul) {
    list-style-type: disc;
    margin-left: 1rem;
  }
</style>
