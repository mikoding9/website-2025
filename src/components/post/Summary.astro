---
import { fetchPosts } from "../../utils/api";

const { currentSlug, post } = Astro.props;
const allPosts = await fetchPosts();
const posts = allPosts.filter((p) => p.slug !== currentSlug);
---

<section
  class='w-full px-3 sm:px-6 grid grid-cols-1 lg:grid-cols-4 gap-4 sm:gap-6 text-neutral-800'
>
  <h5 class='text-2xl sm:text-3xl lg:text-4xl'>Summary</h5>
  <div class='col-span-1 lg:col-span-3'>
    {
      post.summary && (
        <article
          class='space-y-4 sm:space-y-6 text-sm sm:text-base'
          set:html={post.summary}
        />
      )
    }
  </div>
  <div></div>
  <div class='col-span-1 lg:col-span-3 mt-6 sm:mt-9'>
    <p
      class='w-full border-b border-neutral-600 mb-6 sm:mb-12 text-neutral-500 text-sm sm:text-base'
    >
      Related Articles
    </p>
    <div class='w-full overflow-x-scroll'>
      <div class='flex space-x-3 sm:space-x-5'>
        {
          posts.map(({ title, thumbnail, client, slug }) => (
            <div class='p-3 sm:p-4 border border-neutral-400 rounded-sm min-w-64 sm:min-w-72 z-10 flex flex-col'>
              <h5 class='text-xl sm:text-2xl text-neutral-800 line-clamp-3 mb-3 sm:mb-4 h-20 sm:h-24'>
                {title}
              </h5>
              <img
                src={thumbnail}
                alt={title}
                class='rounded-sm w-full h-40 sm:h-48 object-cover mb-3 sm:mb-4'
              />
              <div class='grid grid-cols-2 gap-3 sm:gap-4 items-center mt-auto'>
                <p class='text-xs sm:text-sm text-neutral-600 line-clamp-3'>
                  {client}
                </p>
                <a
                  href={`/blog/post/${slug}/`}
                  class='text-xs sm:text-sm text-white bg-orange-600 rounded-sm px-2 sm:px-3 py-2 text-center'
                >
                  <span class='sr-only'>{title} - </span>Read More
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .overflow-x-scroll {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .overflow-x-scroll::-webkit-scrollbar {
    display: none;
  }
</style>
