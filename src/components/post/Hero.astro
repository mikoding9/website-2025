---
import share from "../../assets/post/share.svg";
import { formatDate } from "../../utils/func";

const { post } = Astro.props;
---

<section
  class='w-full px-3 sm:px-6 pb-6 sm:pb-12 fade-in-up mt-3 sm:mt-9'
  style='animation-delay: 1400ms;'
>
  <div
    class='grid grid-cols-1 sm:grid-cols-2 py-6 sm:py-10 px-4 sm:px-6 gap-y-6 sm:gap-y-10 gap-x-6 bg-stone-50/70 mb-3 border border-stone-200'
  >
    <div class='col-span-1 sm:col-span-2 flex gap-2'>
      <p
        class='text-stone-50 text-[10px] bg-neutral-900 px-3 py-2 rounded-lg w-fit'
      >
        Blog
      </p>
      <p
        class='border-neutral-900 border text-[10px] text-neutral-900 px-3 py-2 rounded-lg w-fit'
      >
        Post
      </p>
    </div>
    <div class='opacity-90 col-span-1 sm:col-span-2'>
      <h2 class='text-black text-2xl sm:text-3xl lg:text-4xl mb-2'>
        {post.subtitle}
      </h2>
      <h1 class='text-black text-4xl sm:text-5xl lg:text-7xl'>{post.title}</h1>
    </div>
    <div class='col-span-1 sm:col-span-2'>
      <p class='text-neutral-800 text-base sm:text-lg mb-3'>
        {post.synopsis}
      </p>
      <div class='flex flex-wrap gap-4 sm:gap-6'>
        <div>
          <p class='text-xs text-neutral-700'>Topic</p><p
            class='text-lg sm:text-xl text-neutral-600'
          >
            {post.topic}
          </p>
        </div>
        <div>
          <p class='text-xs text-neutral-500'>Publish Date</p><p
            class='text-lg sm:text-xl text-neutral-600'
          >
            {formatDate(post.date_created)}
          </p>
        </div>
      </div>
      <button class='bg-orange-700 py-2 px-3 flex space-x-2 rounded-sm mt-3'
        ><img src={share.src} alt='' /><p class='text-white text-sm'>CTA</p>
      </button>
    </div>
  </div>

  {
    post.hero && (
      <img
        src={`https://panel.braga.co.id/panel/assets/${post.hero}`}
        alt={post.title}
        class='w-full rounded-lg overflow-hidden'
      />
    )
  }
</section>
