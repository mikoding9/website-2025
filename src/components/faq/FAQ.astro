---
import FAQSection from "./FAQSection.astro";
import { fetchFAQs } from "../../utils/api";
import type { FAQItem } from "../../utils/api";
import Hero from "./Hero.astro";

interface Props {
  limit?: number;
  theme?: "dark" | "light";
}

const { limit, theme = "dark" } = Astro.props;

const faqItems = await fetchFAQs();

// Group FAQ items by section, preserving order of first appearance
const sections: Record<string, FAQItem[]> = {};
for (const item of faqItems) {
  if (!sections[item.section]) {
    sections[item.section] = [];
  }
  sections[item.section].push(item);
}

// If limit is set, flatten all items, take the first N, and re-group
let displaySections = sections;
if (limit) {
  const allItems = Object.values(sections).flat();
  const limitedItems = allItems.slice(0, limit);
  displaySections = {};
  for (const item of limitedItems) {
    if (!displaySections[item.section]) {
      displaySections[item.section] = [];
    }
    displaySections[item.section].push(item);
  }
}
---

<div class='px-3 sm:px-6'>
  <Hero theme={theme} />
  <FAQSection sections={displaySections} theme={theme} />
</div>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const allItems = document.querySelectorAll(".faq-item");

    allItems.forEach((item) => {
      const trigger = item.querySelector(".faq-trigger");
      const answer = item.querySelector(".faq-answer");
      const answerInner = item.querySelector(".faq-answer-inner");

      if (!trigger || !answer || !answerInner) return;

      trigger.addEventListener("click", () => {
        const isActive = item.classList.contains("active");

        if (isActive) {
          closeItem(item);
        } else {
          openItem(item);
        }
      });
    });

    function openItem(item) {
      const answer = item.querySelector(".faq-answer");
      const answerInner = item.querySelector(".faq-answer-inner");
      const trigger = item.querySelector(".faq-trigger");

      if (!answer || !answerInner) return;

      item.classList.add("active");
      if (trigger) trigger.setAttribute("aria-expanded", "true");

      const height = answerInner.scrollHeight;
      answer.style.maxHeight = height + "px";
      answer.style.opacity = "1";
    }

    function closeItem(item) {
      const answer = item.querySelector(".faq-answer");
      const trigger = item.querySelector(".faq-trigger");

      if (!answer) return;

      item.classList.remove("active");
      if (trigger) trigger.setAttribute("aria-expanded", "false");

      answer.style.maxHeight = "0";
      answer.style.opacity = "0";
    }

    // Fade-in-up animations for FAQ groups
    const faqGroups = document.querySelectorAll(".faq-group.fade-in-up");

    const scrollObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
          }
        });
      },
      { threshold: 0.1 },
    );

    faqGroups.forEach((el) => {
      scrollObserver.observe(el);
    });
  });
</script>

<style is:global>
  /* Initial hidden state */
  .fade-in-up {
    opacity: 0;
    transform: translateY(30px);
  }

  /* Animation when visible */
  .fade-in-up.visible {
    animation: fadeInUp 0.75s ease-out forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
