---
interface Props {
  theme?: "dark" | "light";
}

const { theme = "dark" } = Astro.props;
const isLight = theme === "light";
---

<section
  class='px-3 sm:px-6 pt-1 fade-in-up sm:pb-16'
  style='animation-delay: 1400ms;'
>
  <div
    class={`grid grid-cols-1 md:grid-cols-2 px-4 md:px-6 py-10 gap-y-10 gap-x-6 lg:border mt-2 w-full max-w-full ${isLight ? " border-stone-300" : " border-neutral-800"}`}
  >
    <div class='col-span-1 md:col-span-2 text-[10px]'>
      <button
        class={`rounded-lg px-3 py-2 ${isLight ? "bg-neutral-800 text-stone-50" : "bg-stone-50 text-neutral-900"}`}
        >FAQ</button
      >
    </div>
    <h2
      class={`text-5xl md:text-6xl lg:text-7xl leading-tight font-host ${isLight ? "text-neutral-900" : "text-stone-100"}`}
    >
      Frequently Asked Questions
    </h2>
    <div
      class={`text-sm md:text-lg gap-y-4 gap-x-6 ${isLight ? "text-neutral-600" : "text-stone-300"}`}
    >
      <p>
        Explore detailed information about Braga Technologies, including our
        core services, industry expertise, implementation methodology, and
        long-term partnership approach. This section is intended to provide
        clarity on how we deliver scalable digital and geospatial solutions that
        meet business and operational needs. For further inquiries, our team is
        available to provide direct assistance.
      </p>
    </div>
  </div>
</section>
